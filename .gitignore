# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS metadata files
._*
.DS_Store

# Claude IDE files — personal settings stay out, shared session setup is tracked.
# settings.local.json is per-machine (local paths, allowed commands) and this repo
# is public: keep it ignored. The SessionStart hook must be tracked, otherwise a
# cloud session starts with no dependencies installed.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
!.claude/launch.json
.claire/
.agents/
.mcp.json
skills-lock.json
