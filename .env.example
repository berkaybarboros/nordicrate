# Variable NAMES only. Never commit a value — not a placeholder that looks real,
# not an expired key. Copy this to .env.local and fill it in locally; on the server
# the real file is /var/www/nordicrate/.env.local.
#
# `npm run build`, `npm run typecheck`, `npm run lint` and `npm test` all pass with
# none of these set, which is what lets a cloud session verify its own work. What
# stops working without them is listed next to each one.

# Absolute site URL used for canonical links and outbound /go redirects.
# Local: http://localhost:3000 — production: https://nordicrate.com
NEXT_PUBLIC_BASE_URL=

# Supabase. The anon key is public by design (it is shipped to the browser) and is
# only safe because every table has RLS. The service-role key bypasses RLS: it
# belongs to server code and /admin only, and must never be imported from a client
# component. Without these: live rates fall back to the static catalogue, /admin
# shows nothing, and no lead or feedback is stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — the AI assistant. Without it /api/chat returns an error.
GROQ_API_KEY=

# Gemini — embeddings for /api/cron/generate-embeddings only. Without it that one
# endpoint returns 503; nothing else notices.
GEMINI_API_KEY=

# Shared secret in the x-cron-secret header of every /api/cron/* call. The server's
# crontab and the n8n credential carry the same value; rotating it means changing
# all three. Without it those endpoints answer 401.
CRON_SECRET=

# Password for /admin. A long random string — the cookie stores its SHA-256 hash.
ADMIN_TOKEN=
