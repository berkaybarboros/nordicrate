# Shell scripts must keep LF in the repository: they are edited on Windows but run
# in Linux (the cloud container and the VPS). A CRLF here fails with
# "$'\r': command not found", which reads like a syntax error and is not one.
*.sh text eol=lf

# claims-to-verify.json is generated by `UPDATE_CLAIMS=1 npm test` with LF and
# compared byte-for-byte against that output. Letting Windows check it out as
# CRLF made the test fail locally and pass in CI.
deploy/scraper/claims-to-verify.json text eol=lf
